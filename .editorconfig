# Editor settings for the claude-skills repo. These mirror the ruff configuration in
# pyproject.toml — when you change one, change the other.
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 120

[*.py]
indent_size = 4
# Matches [tool.ruff.format] quote-style.
quote_type = double

[*.{yml,yaml,json,toml}]
indent_size = 2

[*.md]
indent_size = 2
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.{diff,patch}]
trim_trailing_whitespace = false
